# CineBook AI - Backend Environment Variables

# Database Configuration (Dual Support: SQLite for lightweight dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./cinebook.db
# DATABASE_URL=postgresql://cinebook_user:cinebook_secure_password_2026@localhost:5432/cinebook_db

# Redis Cache & Ephemeral Locking
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=cinebook_super_secret_jwt_key_interview_showcase_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seat Lock Duration (TTL in seconds: default 300s = 5 minutes)
SEAT_LOCK_TTL_SECONDS=300

# Pricing & Tax Configuration (Backend Single Source of Truth)
CONVENIENCE_FEE_PERCENT=5.0
GST_TAX_PERCENT=18.0

# Paytm Payment Gateway Integration (Staging Credentials)
PAYTM_ENV=STAGING
PAYTM_MID=YOUR_PAYTM_STAGING_MID
PAYTM_MERCHANT_KEY=YOUR_PAYTM_STAGING_KEY
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CALLBACK_URL=http://localhost:8000/api/v1/payments/paytm/callback

# Demo Payment Simulator (Essential for interview demo without live bank card)
ENABLE_DEMO_PAYMENT_SIMULATOR=true

# External Movie Metadata & Enrichment API (TMDB or OMDb)
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# Machine Learning Engine Configuration
ML_MODEL_DIR=app/ml/artifacts
ML_HYBRID_CONTENT_WEIGHT=0.7
ML_HYBRID_COLLAB_WEIGHT=0.3

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
